@model Legacy.Models.MiEscritorioViewModel

@{
    ViewData["Title"] = "Mi Escritorio";
}

<section class="mi-escritorio" aria-labelledby="mi-escritorio-title">
    <header class="component-header mi-escritorio__header">
        <h1 id="mi-escritorio-title"><i class="fas fa-chart-bar" aria-hidden="true"></i> Mi Escritorio</h1>
        <nav class="mi-escritorio__menu" aria-label="Opciones de Mi Escritorio">
            <button type="button" class="mi-escritorio__menu-item">Manser</button>
            <button type="button" class="mi-escritorio__menu-item">Retcli</button>
            <button type="button" class="mi-escritorio__menu-item">Segen</button>
        </nav>
    </header>

    <div class="card mi-escritorio__content">
        <div class="card-body">
            <div class="mi-escritorio__actions">
                <div class="mi-escritorio__role-field">
                    <label for="selRol" class="form-label mb-0">Rol Activo</label>
                    <select id="selRol" name="selRol" class="form-select" aria-label="Rol Activo">
                        <option value="">Seleccione un rol</option>
                        @foreach (string rol in Model.Roles)
                        {
                            <option value="@rol" class="option">@rol</option>
                        }
                    </select>

                    <input id="txtRol" name="txtRol" type="text" class="form-control" placeholder="Rol Actual" aria-label="Rol Actual" />
                    <button id="cmdRol" name="cmdRol" type="button" class="btn btn-secondary" >Cargar</button>
                </div>
                <button type="button" class="btn btn-primary mi-escritorio__read-button" id="cmdLeer" name="cmdLeer">Leer</button>
            </div>

            <div class="table-responsive mi-escritorio__table-wrapper">
                <table class="table table-striped table-hover align-middle mb-0" id="grdMensajes">
                    <thead>
                        <tr>
                            <th scope="col">Nro.Mensaje</th>
                            <th scope="col">Referencia</th>
                            <th scope="col">Rol Anterior</th>
                            <th scope="col">Rol Actual</th>
                            <th scope="col">Fecha Traspaso</th>
                            <th scope="col">Etiqueta</th>
                            <th scope="col">Procedimiento</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (TraspasoMensajeViewModel mensaje in Model.Mensajes)
                    {
                        <tr>
                            <td>@mensaje.NroMensaje</td>
                            <td>@mensaje.Referencia</td>
                            <td>@mensaje.RolAnterior</td>
                            <td>@mensaje.RolActual</td>
                            <td>@mensaje.FechaTraspaso.ToString("dd/MM/yyyy")</td>
                            <td>@mensaje.Etiqueta</td>
                            <td>@mensaje.Procedimiento</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById("cmdRol").addEventListener("click", async () => {
            const txtRol = document.getElementById("txtRol");
            const selRol = document.getElementById("selRol");
            const rol = txtRol.value.trim();

            if (!rol) {
                txtRol.setCustomValidity("Debe ingresar un rol.");
                txtRol.reportValidity();
                txtRol.focus();
                return;
            }

            txtRol.setCustomValidity("");
            txtRol.value = rol.toUpperCase();
            selRol.disabled = true;

            try {
                const response = await fetch("@Url.Action(action: "GetRolesAsync", controller: "MiEscritorio")?rol=" + encodeURIComponent(txtRol.value));
                if (!response.ok) {
                    throw new Error("Response Not OK. No se pudieron cargar los roles." + response.url + " - " + response.status + " - " + response.statusText);
                }

                const roles = await response.json();
                selRol.replaceChildren(new Option("Seleccione un rol", ""));

                for (const rolDisponible of roles) {
                    selRol.add(new Option(rolDisponible, rolDisponible));
                }

            } catch (error) {

                selRol.replaceChildren(new Option("Error.No se pudieron cargar los roles. " + error.message, ""));
            } finally {
                selRol.disabled = false;
            }
        });

        document.getElementById("cmdLeer").addEventListener("click", async () => {
            const selRol = document.getElementById("selRol");
            const rol = selRol.value.trim();

            if (!rol) {
                selRol.setCustomValidity("Debe seleccionar un rol.");
                selRol.reportValidity();
                selRol.focus();
                return;
            }else{
                alert("Rol seleccionado: " + rol);
            }

            try {
                const response = await fetch("@Url.Action(action: "GetMiEscritorioAsync", controller: "MiEscritorio")?rol=" + encodeURIComponent(rol));
                if (!response.ok) {
                    throw new Error("Response Not OK. No se pudieron cargar los mensajes." + response.url + " - " + response.status + " - " + response.statusText);
                }
                
                //const msg = await response.text();
                //alert("Respuesta del servidor: " + msg);

                const mensajes = await response.json();
                const cuerpoTabla = document.querySelector("#grdMensajes tbody");
                const formatoFecha = new Intl.DateTimeFormat("es-AR");

                alert("Mensajes cargados: " + mensajes.length);


                cuerpoTabla.replaceChildren();

                for (const mensaje of mensajes) {
                    const fila = document.createElement("tr");
                    const valores = [
                        mensaje.nroMensaje,
                        mensaje.referencia,
                        mensaje.rolAnterior,
                        mensaje.rolActual,
                        formatoFecha.format(new Date(mensaje.fechaTraspaso)),
                        mensaje.etiqueta,
                        mensaje.procedimiento
                    ];

                    for (const valor of valores) {
                            const celda = document.createElement("td");
                            celda.textContent = valor ?? "";
                            fila.append(celda);
                    }                                    
                    cuerpoTabla.append(fila);
                }
            } catch (error) {
                console.error("Error al cargar los mensajes:", error);
            }
        });
    </script>
}
